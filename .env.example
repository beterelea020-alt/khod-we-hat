# ───────── خد وهات — Environment variables ─────────
# Local: copy to .env   |   Vercel: Project → Settings → Environment Variables

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # server only — never expose in the browser

# Supabase → Connect → "Transaction pooler" (port 6543). REQUIRED on Vercel (serverless).
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres
DB_SSL=true
DB_POOL_MAX=1

# Public site URL (used in password-reset emails and CORS). Comma-separate to allow several.
CLIENT_URL=https://your-app.vercel.app
PASSWORD_RESET_REDIRECT_URL=https://your-app.vercel.app/#reset-password

# Smart assistant (optional — without it the assistant falls back to rule-based answers)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# First super-admin, created by `npm run seed` (choose a strong password, 10+ characters).
# ⚠ Do NOT use the "#" character in the password: .env treats everything after # as a comment.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# ───────── LOCAL development with `npx supabase start` (Docker) ─────────
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=<ANON_KEY from `npx supabase status -o env`   (starts with eyJ)>
# SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from the same command>
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DB_SSL=false          # the local database has no SSL — leaving this true makes the connection fail
# CLIENT_URL=http://localhost:4000
# PASSWORD_RESET_REDIRECT_URL=http://localhost:4000/#reset-password
