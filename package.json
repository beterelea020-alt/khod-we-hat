{
  "name": "khod-we-hat-platform",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "خد وهات — منصة مصرية للتبادل: مهارات، خدمات، منتجات، وقت ومعرفة (Vercel + Supabase)",
  "scripts": {
    "dev": "node --watch backend/src/server.js",
    "start": "node backend/src/server.js",
    "seed": "node backend/src/seed.js",
    "seed:demo": "node backend/src/seed.js --demo",
    "check": "node --check backend/src/app.js && node --check api/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:cloud": "node scripts/check-cloud-env.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^2.1.9"
  }
}
